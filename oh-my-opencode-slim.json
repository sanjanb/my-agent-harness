      ],
      "orchestratorPrompt": "Use for CI/CD pipelines, Docker, Kubernetes, Terraform, infrastructure-as-code, deployment automation, cloud architecture, monitoring, and observability tasks."
    },
    "development-test-engineer": {
      "model": "opencode/deepseek-v4-flash-free",
      "variant": "medium",
