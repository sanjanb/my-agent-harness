# my-agent-harness Environment Variables
# Copy this file to .env and fill in your values

# Context7 API Key (for library documentation)
# Get yours at https://context7.com
CONTEXT7_API_KEY=ctx7sk-your-key-here

# Exa API Key (for web search)
# Get yours at https://exa.ai
EXA_API_KEY=your-exa-key-here

# Composio API Key (for integrations)
# Get yours at https://composio.dev
COMPOSIO_API_KEY=your-composio-key-here

# GitHub Token (for gh_grep MCP)
# Create at https://github.com/settings/tokens
GITHUB_TOKEN=ghp_your-token-here

# OpenCode API Key (if using hosted)
# OPENCE_API_KEY=your-opencode-key

# Optional: Custom model endpoints
# OPENAI_API_KEY=sk-your-key
# ANTHROPIC_API_KEY=sk-ant-your-key